# O modo inicial usa templates locais e não precisa de nenhuma variável.
# A integração de ilustração é opcional e nunca publica conteúdo.
OPENAI_API_KEY=
MARKETING_ENABLE_AI_IMAGES=false
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium

# Mantidas para compatibilidade com o gerador editorial existente.
MARKETING_GENERATION_API_URL=
MARKETING_GENERATION_API_KEY=

# Capturas do produto ficam desativadas por padrão.
MARKETING_SCREENSHOT_ALLOW=false
MARKETING_SCREENSHOT_BASE_URL=
MARKETING_BROWSER_PATH=
